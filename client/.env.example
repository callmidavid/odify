# For local development — Vite proxy handles API routing
# No env vars needed for dev — just pnpm run dev

# For production — set the backend URL
# ODIFY_API_URL=https://odify-9m1f.onrender.com

# Google sign-in (optional — email/password works without it)
# Get one at https://console.cloud.google.com/apis/credentials
# ODIFY_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
